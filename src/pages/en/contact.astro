---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "en/-index");
const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title.toUpperCase()} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="max-w-lg mr-auto ml-0 text-left">
          <form id="contact-form" action={contact_form_action} method="POST">
            <div class="mb-6">
              <label for="name" class="form-label">
                Name <span class="text-red-500">*</span>
              </label>
              <input
                id="name"
                name="name"
                class="form-input"
                placeholder="John Doe"
                type="text"
                required
              />
            </div>
            <div class="mb-6">
              <label for="email" class="form-label">
                Email <span class="text-red-500">*</span>
              </label>
              <input
                id="email"
                name="email"
                class="form-input"
                placeholder="john.doe@email.com"
                type="email"
                required
              />
            </div>
            <div class="mb-6">
              <label for="message" class="form-label">
                Message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input"
                placeholder="Write your message here..."
                required
                rows="8"></textarea>
            </div>
            <button id="submit-btn" type="submit" class="btn btn-primary">
              Send Message
            </button>
            <p id="form-status" class="mt-4 hidden text-sm font-medium"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const status = document.getElementById("form-status");

    if (!form || !submitBtn || !status) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";
      status.classList.add("hidden");
      status.classList.remove("text-red-500", "text-green-600", "dark:text-green-400");

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: data,
          headers: { Accept: "application/json" },
        });

        status.classList.remove("hidden");
        if (response.ok) {
          status.textContent = "Your message has been sent successfully. Thank you!";
          status.classList.add("text-green-600", "dark:text-green-400");
          form.reset();
        } else {
          status.textContent = "Failed to send message. Please try again later.";
          status.classList.add("text-red-500");
        }
      } catch {
        status.classList.remove("hidden");
        status.textContent = "A network error occurred. Please check your connection.";
        status.classList.add("text-red-500");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send Message";
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>
