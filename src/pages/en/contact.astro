---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "en/-index");
const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}

const CONTACT_EMAIL = "";
const MAILCHIMP_ACTION = "https://ksonimage.us10.list-manage.com/subscribe/post?u=83f4e325e506570a2d93302f6&id=6968b4186e&f_id=003455e4f0";
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />

  <section class="text-gray-900 body-font w-full">
    <div class="container px-5 pt-20 pb-24 mx-auto space-y-20">

      {/* 1. [Row 1] Inquiries */}
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-y-8 lg:gap-x-10">
        <aside class="lg:col-span-1">
          <div class="space-y-6 lg:pr-4">
            <div>
              <h2 class="text-xs font-mono uppercase tracking-widest text-gray-900 mb-3">
                Inquiries
              </h2>
              <p class="text-xs text-gray-800 font-sans leading-relaxed">
                For exhibitions, screenings, screener requests, or collaborations, please use the form on the right.
              </p>
            </div>

            {CONTACT_EMAIL && (
              <div class="pt-2">
                <span class="block text-[11px] font-mono uppercase tracking-wider text-gray-400 mb-1">
                  Direct Email
                </span>
                <a
                  href={`mailto:${CONTACT_EMAIL}`}
                  class="text-xs font-mono text-gray-900 border-b border-gray-300 pb-0.5 hover:border-black transition-colors"
                >
                  {CONTACT_EMAIL}
                </a>
              </div>
            )}
          </div>
        </aside>

        <div class="lg:col-span-2">
          <form
            id="contact-form"
            action={contact_form_action}
            method="POST"
            class="space-y-8"
            data-btn-default="Send"
            data-btn-loading="Sending..."
            data-msg-success="Your message has been sent. Thank you."
            data-msg-error="Failed to send message. Please try again later."
            data-msg-network="A network error occurred. Please check your connection."
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <div>
                <label
                  for="name"
                  class="block text-xs font-mono uppercase tracking-wider text-neutral-800 mb-2"
                >
                  Name <span class="text-gray-900">*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  placeholder="Your name or affiliation"
                  class="w-full bg-transparent border-0 border-b border-gray-700 px-0 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-black focus:ring-0 focus:outline-none transition-colors rounded-none"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="block text-xs font-mono uppercase tracking-wider text-neutral-800 mb-2"
                >
                  Email <span class="text-gray-900">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="name@example.com"
                  class="w-full bg-transparent border-0 border-b border-gray-700 px-0 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-black focus:ring-0 focus:outline-none transition-colors rounded-none"
                />
              </div>
            </div>

            <div>
              <label
                for="message"
                class="block text-xs font-mono uppercase tracking-wider text-neutral-800 mb-2"
              >
                Message <span class="text-gray-900">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder="Write your message here."
                class="w-full bg-transparent border-0 border-b border-gray-700 px-0 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-black focus:ring-0 focus:outline-none transition-colors resize-y rounded-none leading-relaxed"
              ></textarea>
            </div>

            <div class="pt-2 flex items-center gap-4">
              <button
                id="submit-btn"
                type="submit"
                class="px-7 py-3 text-xs font-mono uppercase tracking-widest border border-black bg-black text-white hover:bg-white hover:text-black transition-colors cursor-pointer rounded-none"
              >
                Send
              </button>
              <p id="form-status" class="hidden text-xs font-sans"></p>
            </div>
          </form>
        </div>

        <div class="hidden lg:block lg:col-span-1" aria-hidden="true"></div>
      </div>

      {/* 2. [Row 2] Newsletter */}
      <div id="newsletter" class="grid grid-cols-1 lg:grid-cols-4 gap-y-8 lg:gap-x-10 scroll-mt-12">
        <div class="lg:col-span-3 px-6 py-8 sm:px-8 sm:py-10">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-y-8 lg:gap-x-10 items-start">
            <aside class="lg:col-span-1">
              <div class="lg:pr-4">
                <h2 class="text-xs font-mono uppercase tracking-widest text-gray-900 mb-3">
                  Newsletter
                </h2>
                <p class="text-xs text-gray-700 font-sans leading-relaxed">
                  Subscribe to receive updates on upcoming exhibitions, screenings, and archive releases.
                </p>
              </div>
            </aside>

            <div class="lg:col-span-2">
              <form
                id="newsletter-form"
                action={MAILCHIMP_ACTION}
                method="post"
                class="flex flex-col sm:flex-row items-stretch sm:items-end gap-5"
                data-btn-default="Subscribe"
                data-btn-loading="Processing..."
                data-msg-success="Thank you for subscribing to our newsletter."
                data-msg-already="This email address is already subscribed."
                data-msg-error="An error occurred while subscribing. Please check your email address."
                data-msg-blocked="Connection blocked by browser settings or local environment."
              >
                <div class="sm:w-1/3">
                  <label for="mce-MMERGE3" class="sr-only">Name</label>
                  <input
                    id="mce-MMERGE3"
                    type="text"
                    name="MMERGE3"
                    required
                    placeholder="Name"
                    class="w-full bg-transparent border-0 border-b border-gray-700 px-0 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-black focus:ring-0 focus:outline-none transition-colors rounded-none"
                  />
                </div>

                <div class="flex-1">
                  <label for="mce-EMAIL" class="sr-only">Email Address</label>
                  <input
                    id="mce-EMAIL"
                    type="email"
                    name="EMAIL"
                    required
                    placeholder="Email"
                    class="w-full bg-transparent border-0 border-b border-gray-700 px-0 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-black focus:ring-0 focus:outline-none transition-colors rounded-none"
                  />
                </div>

                <div style="position: absolute; left: -5000px;" aria-hidden="true">
                  <input type="text" name="b_83f4e325e506570a2d93302f6_6968b4186e" tabindex="-1" value="" />
                </div>

                <button
                  id="mc-submit-btn"
                  type="submit"
                  class="px-6 py-2.5 text-xs font-mono uppercase tracking-widest border border-black text-black hover:bg-black hover:text-white transition-colors cursor-pointer shrink-0 rounded-none"
                >
                  Subscribe
                </button>
              </form>
              <p id="mc-status" class="hidden mt-3 text-xs font-sans"></p>
            </div>
          </div>
        </div>

        <div class="hidden lg:block lg:col-span-1" aria-hidden="true"></div>
      </div>

    </div>
  </section>
</Base>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const status = document.getElementById("form-status");

    if (!form || !submitBtn || !status || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const btnDefault = form.dataset.btnDefault || "Send";
    const btnLoading = form.dataset.btnLoading || "Sending...";
    const msgSuccess = form.dataset.msgSuccess || "Your message has been sent. Thank you.";
    const msgError = form.dataset.msgError || "Failed to send message. Please try again later.";
    const msgNetwork = form.dataset.msgNetwork || "A network error occurred. Please check your connection.";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      submitBtn.disabled = true;
      submitBtn.textContent = btnLoading;
      status.classList.add("hidden");
      status.classList.remove("text-red-600", "text-gray-900");

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: data,
          headers: { Accept: "application/json" },
        });

        status.classList.remove("hidden");
        if (response.ok) {
          status.textContent = msgSuccess;
          status.classList.add("text-gray-900");
          form.reset();
        } else {
          status.textContent = msgError;
          status.classList.add("text-red-600");
        }
      } catch {
        status.classList.remove("hidden");
        status.textContent = msgNetwork;
        status.classList.add("text-red-600");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = btnDefault;
      }
    });
  }

  function initNewsletterForm() {
    const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("mc-submit-btn") as HTMLButtonElement | null;
    const status = document.getElementById("mc-status");
    const nameInput = document.getElementById("mce-MMERGE3") as HTMLInputElement | null;
    const emailInput = document.getElementById("mce-EMAIL") as HTMLInputElement | null;

    if (!form || !submitBtn || !status || !nameInput || !emailInput || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const btnDefault = form.dataset.btnDefault || "Subscribe";
    const btnLoading = form.dataset.btnLoading || "Processing...";
    const msgSuccess = form.dataset.msgSuccess || "Thank you for subscribing to our newsletter.";
    const msgAlready = form.dataset.msgAlready || "This email address is already subscribed.";
    const msgError = form.dataset.msgError || "An error occurred while subscribing.";
    const msgBlocked = form.dataset.msgBlocked || "Connection blocked by browser settings or local environment.";

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const actionUrl = form.getAttribute("action") || "";
      submitBtn.disabled = true;
      submitBtn.textContent = btnLoading;
      status.classList.add("hidden");
      status.classList.remove("text-red-600", "text-gray-900");

      const jsonUrl = actionUrl.replace("/post?", "/post-json?");
      const callbackName = "mcCallback_" + Date.now();
      const mmerge3 = encodeURIComponent(nameInput.value.trim());
      const email = encodeURIComponent(emailInput.value.trim());

      (window as any)[callbackName] = (res: any) => {
        delete (window as any)[callbackName];
        script.remove();
        submitBtn.disabled = false;
        submitBtn.textContent = btnDefault;
        status.classList.remove("hidden");

        if (res.result === "success") {
          status.textContent = msgSuccess;
          status.classList.add("text-gray-900");
          form.reset();
        } else {
          const tempDiv = document.createElement("div");
          tempDiv.innerHTML = String(res.msg || "");
          const cleanMsg = (tempDiv.textContent || tempDiv.innerText || "").replace(/^\d+\s*-\s*/, "").trim();

          if (cleanMsg.includes("already subscribed") || cleanMsg.includes("이미 구독")) {
            status.textContent = msgAlready;
          } else if (/[ㄱ-ㅎ|ㅏ-ㅣ|가-힣]/.test(cleanMsg) || !cleanMsg) {
            // Mailchimp 서버가 한국어 에러 메시지를 반환한 경우 영문 기본 에러로 치환
            status.textContent = msgError;
          } else {
            status.textContent = cleanMsg;
          }
          status.classList.add("text-red-600");
        }
      };

      const script = document.createElement("script");
      script.src = `${jsonUrl}&MMERGE3=${mmerge3}&EMAIL=${email}&c=${callbackName}`;
      script.onerror = () => {
        delete (window as any)[callbackName];
        script.remove();
        submitBtn.disabled = false;
        submitBtn.textContent = btnDefault;
        status.classList.remove("hidden");
        status.textContent = msgBlocked;
        status.classList.add("text-red-600");
      };
      document.body.appendChild(script);
    });
  }

  initContactForm();
  initNewsletterForm();
  document.addEventListener("astro:page-load", () => {
    initContactForm();
    initNewsletterForm();
  });
</script>
