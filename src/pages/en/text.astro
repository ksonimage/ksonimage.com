---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { render } from "astro:content";
import PageHeader from "@/partials/PageHeader.astro";

const pageIndex = await getListPage("text", "en/-index");
const { Content } = await render(pageIndex);
const { title, description, meta_title, image } = pageIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && pageIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />

  <section class="section-sm">
    <div class="container">
      <div class="row justify-left">
        <div class="w-full md:col-10 lg:col-8">
          {
            image && (
              <ImageMod
                class="mx-auto mb-6 rounded w-full"
                src={image}
                width={1200}
                height={600}
                alt={title}
                format="webp"
              />
            )
          }

          {/* w-full 및 text-content 영역 적용 */}
          <div id="text-content" class="text-content w-full font-mono text-sm leading-relaxed">
            <Content />
          </div>

        </div>
      </div>
    </div>
  </section>

  {/* PDF / Google Drive Lightbox Modal */}
  <div
    id="pdf-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/65 backdrop-blur-[2px] p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pdf-lightbox-title"
  >
    <div class="relative flex flex-col w-full max-w-5xl h-[88vh] bg-white border border-gray-900 shadow-2xl">
      {/* Top Bar: Document Title / Open in New Tab / Close */}
      <div class="flex items-center justify-between gap-4 px-5 py-3.5 border-b border-gray-200 bg-white shrink-0">
        <p
          id="pdf-lightbox-title"
          class="text-xs font-mono text-gray-900 truncate"
        >
          Document
        </p>

        <div class="flex items-center gap-5 shrink-0">
          <a
            id="pdf-lightbox-external"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono uppercase tracking-wider text-gray-600 hover:text-black transition-colors"
          >
            New Tab ↗
          </a>
          <button
            id="pdf-lightbox-close"
            type="button"
            class="text-xs font-mono uppercase tracking-widest text-gray-900 hover:opacity-50 transition-opacity cursor-pointer"
          >
            Close [ESC]
          </button>
        </div>
      </div>

      {/* Document Viewer */}
      <div class="relative flex-1 w-full bg-neutral-100">
        <iframe
          id="pdf-lightbox-frame"
          src=""
          title="Document Viewer"
          allow="autoplay"
          class="w-full h-full border-0"
        ></iframe>
      </div>
    </div>
  </div>
</Base>

<script>
  function getEmbedUrl(url: string): string | null {
    // 1. Google Drive /file/d/{id}/...
    const driveFileMatch = url.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
    if (driveFileMatch?.[1]) {
      return `https://drive.google.com/file/d/${driveFileMatch[1]}/preview`;
    }

    // 2. Google Drive /open?id={id} or /uc?id={id}
    const driveIdMatch = url.match(/drive\.google\.com\/(?:open|uc)\?.*[?&]?id=([a-zA-Z0-9_-]+)/);
    if (driveIdMatch?.[1]) {
      return `https://drive.google.com/file/d/${driveIdMatch[1]}/preview`;
    }

    // 3. Direct .pdf links
    if (/\.pdf($|[?#])/i.test(url)) {
      return url.includes("#") ? url : `${url}#view=FitH`;
    }

    return null;
  }

  function initPdfLightbox() {
    const contentArea = document.getElementById("text-content");
    const modal = document.getElementById("pdf-lightbox");
    const frame = document.getElementById("pdf-lightbox-frame") as HTMLIFrameElement | null;
    const titleEl = document.getElementById("pdf-lightbox-title");
    const externalLink = document.getElementById("pdf-lightbox-external") as HTMLAnchorElement | null;
    const closeBtn = document.getElementById("pdf-lightbox-close");

    if (!contentArea || !modal || !frame || !titleEl || !externalLink || !closeBtn) return;
    if (contentArea.dataset.pdfBound === "true") return;
    contentArea.dataset.pdfBound = "true";

    const openModal = (originalUrl: string, embedUrl: string, label: string) => {
      titleEl.textContent = label || "Document";
      externalLink.href = originalUrl;
      frame.src = embedUrl;

      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      frame.src = "";
      document.body.style.overflow = "";
    };

    contentArea.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const anchor = target?.closest("a");
      if (!anchor) return;

      const embedUrl = getEmbedUrl(anchor.href);
      if (!embedUrl) return;

      if (window.innerWidth < 640) return;

      e.preventDefault();
      openModal(anchor.href, embedUrl, anchor.textContent?.trim() || "");
    });

    closeBtn.addEventListener("click", closeModal);

    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  initPdfLightbox();
  document.addEventListener("astro:page-load", initPdfLightbox);
</script>

{/* 💡 폭 100%, 리스트 정렬, 그리고 링크 언더라인 스타일 강제 지정 */}
<style is:global>
  .text-content {
    width: 100% !important;
  }

  /* 본문 내 링크(a 태그) 언더라인 설정 */
  .text-content a {
    text-decoration: underline !important;
    text-underline-offset: 4px !important;
    text-decoration-thickness: 1px !important;
    transition: opacity 0.2s ease !important;
  }

  .text-content a:hover {
    opacity: 0.6 !important;
  }

  .text-content ul {
    width: 100% !important;
    list-style-type: disc !important;
    list-style-position: outside !important;
    padding-left: 1.5rem !important;
    margin-top: 1rem !important;
    margin-bottom: 1rem !important;
    box-sizing: border-box !important;
  }

  .text-content ol {
    width: 100% !important;
    list-style-type: decimal !important;
    list-style-position: outside !important;
    padding-left: 1.5rem !important;
    margin-top: 1rem !important;
    margin-bottom: 1rem !important;
    box-sizing: border-box !important;
  }

  .text-content li {
    width: 100% !important;
    display: list-item !important;
    padding-left: 0.25rem !important;
    margin-bottom: 0.5rem !important;
    box-sizing: border-box !important;
  }
</style>
