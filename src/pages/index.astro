---
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import config from "@/config/config.json";
import BlogList from "@/components/BlogList.astro";
import Pagination from "@/components/Pagination.astro";

const BLOG_FOLDER = "blog";
const POSTS_PER_PAGE = 7;

const homepage = await getListPage("homepage", "-index");
const { title, description } = homepage?.data || {};

const allPosts = await getSinglePage(BLOG_FOLDER);

// 💡 영문 포스트 및 -index 메타 파일 제외
const krPosts = allPosts.filter((post) => {
  const id = post.id || "";
  const slug = post.slug || "";
  const isEn = id.startsWith("en/") || slug.startsWith("en/");
  const isIndex = id.includes("-index") || slug.includes("-index");

  return !isEn && !isIndex;
});

const formattedPosts = krPosts.map((post) => {
  const rawSlug = post.slug || post.id;
  const cleanSlug = rawSlug.replace(/\.(md|mdx)$/, "");
  return {
    ...post,
    slug: cleanSlug,
  };
});

const sortedPosts = sortByDate(formattedPosts);

const totalPages: number = Math.ceil(
  formattedPosts.length / POSTS_PER_PAGE
);

const currentPosts = sortedPosts.slice(0, POSTS_PER_PAGE);
---

<Base title="홈">
{/* 💡 접속자 브라우저 언어 감지 및 자동 리다이렉트 스크립트 */}
  <script is:inline>
    (function () {
      // 세션 세이프티: 이미 체킹했거나 사용자가 수동으로 메인에 돌아왔을 땐 다시 튕겨내지 않음
      const hasChecked = sessionStorage.getItem("lang_redirected");

      if (!hasChecked) {
        const userLang = (navigator.language || navigator.userLanguage || "").toLowerCase();

        // 한국어(ko, ko-KR 등)가 아니면 trailingSlash 없이 /en 으로 이동
        if (!userLang.startsWith("ko")) {
          sessionStorage.setItem("lang_redirected", "true");
          window.location.replace("/en");
          return;
        }

        sessionStorage.setItem("lang_redirected", "true");
      }
    })();
  </script>

  <!-- container 대신 w-full px-0 사용으로 좌우 여백 완전히 제거 -->
  <div class="w-full px-0 pt-36">
    {/* 블로그 포스트 리스트 */}
    <BlogList posts={currentPosts} />

    {/* 페이지네이션 */}
    {totalPages > 1 && (
      <div class="mt-20 mb-16 flex justify-center">
        {/*
        <Pagination section={BLOG_FOLDER} currentPage={1} totalPages={totalPages} />
        */}
        <Pagination currentPage={1} totalPages={totalPages} />
      </div>
    )}
  </div>
</Base>
