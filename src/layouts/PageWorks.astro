---
import ImageMod from "@/components/ImageMod.astro";
import Gallery from "@/components/Gallery.astro"; // 💡 PhotoSwipe 갤러리 컴포넌트 추가

const { data, Content } = Astro.props;

const rawTitle = String(data?.title || "");
const info = data?.info || data?.description || "";
const image = String(data?.image || "");
const vimeoId = data?.vimeoId || "";

const rawGallery = data?.gallery;
const galleryImages: string[] = Array.isArray(rawGallery)
  ? rawGallery
  : typeof rawGallery === "string" && rawGallery.trim() !== ""
  ? [rawGallery]
  : [];

const plainTitle = rawTitle.replace(/["'\\`]/g, "").replace(/[\r\n]+/g, " ").trim();
---

<section class="py-8">
  <div class="container mx-auto px-0">

    <!-- 1. 첫 번째 행: Full-size 타이틀 헤더 + 작품 기본 정보(info) -->
    {rawTitle && (
      <div class="w-full mb-10 border-none pb-4 text-left px-0 py-3">
        <h1 class="text-[4rem] lg:text-[5rem] font-[100] text-gray-900 tracking-wide leading-tight">
          {rawTitle}
        </h1>
        {info && (
          <p class="px-3 mt-3 text-sm lg:text-base text-gray-700 font-light tracking-wide">
            {info}
          </p>
        )}
      </div>
    )}

    <!-- 2. 두 번째 행: 6:4 비율의 본문 및 미디어 그리드 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start py-5">

      <!-- 왼쪽 60% (7 columns) : 마크다운 본문 -->
      <div class="lg:col-span-7 w-full">
        <div class="content leading-relaxed text-base text-gray-700 space-y-6">
          {Content && <Content />}
        </div>
      </div>

      <!-- 오른쪽 40% (5 columns) : Vimeo + 갤러리 이미지 (라이트박스 적용) -->
      <div class="lg:col-span-5 w-full space-y-6">

        {vimeoId && (
          <div class="w-full rounded-none overflow-hidden shadow-md bg-black aspect-video">
            <iframe
              src={`https://player.vimeo.com/video/${vimeoId}?badge=0&autopause=0&player_id=0`}
              class="w-full h-full border-0"
              allow="autoplay; fullscreen; picture-in-picture"
              title="Vimeo Video"
            ></iframe>
          </div>
        )}

        {!vimeoId && image && (
          <div class="w-full rounded-none overflow-hidden shadow-md bg-gray-100 aspect-video">
            <ImageMod
              src={image}
              height={500}
              width={700}
              alt={plainTitle}
              class="object-cover object-center h-full w-full"
              format="webp"
            />
          </div>
        )}

        {/* 💡 기존 ImageMod 반복문 대신 PhotoSwipe 라이트박스가 내장된 Gallery 컴포넌트로 교체 */}
        {galleryImages.length > 0 && (
          <div class="pt-2">
            <Gallery images={galleryImages} />
          </div>
        )}

      </div>

    </div>
  </div>
</section>
