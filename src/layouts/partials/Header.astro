---
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { pathname } = Astro.url;

// 현재 URL이 /en 또는 /en/... 으로 시작하는지 판별
const isEn = pathname === "/en" || pathname.startsWith("/en/");

// menu.json 내부의 main / main_en 메뉴 스위칭
const main: NavigationLink[] = isEn ? menu.main_en : menu.main;

const { navigation_button, settings } = config;
---

<header class={`header z-30 ${settings.sticky_header && "sticky top-0"}`}>
  <nav class="navbar container">
    <!-- logo -->
    <div class="order-0">
      <Logo />
    </div>

    <!-- PC 전용 메뉴 (lg 이상에서만 표시) -->
    <ul
      class="navbar-nav hidden lg:order-1 lg:flex lg:w-auto lg:space-x-2 xl:space-x-8"
    >
      {
        main.map((menu) => (
          <>
            {menu.hasChildren ? (
              <li class="nav-item nav-dropdown group relative">
                <button
                  type="button"
                  aria-expanded="false"
                  class={`nav-dropdown-toggle nav-link inline-flex items-center cursor-pointer ${
                    menu.children?.map(({ url }) => url).includes(pathname) ||
                    menu.children
                      ?.map(({ url }) => `${url}/`)
                      .includes(pathname)
                      ? "active"
                      : ""
                  }`}
                >
                  {menu.name}
                  <svg class="h-4 w-4 fill-current ml-1" viewBox="0 0 20 20">
                    <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                  </svg>
                </button>
                <ul class="nav-dropdown-list invisible absolute block opacity-0 group-hover:visible group-hover:opacity-100 group-[.is-open]:visible group-[.is-open]:opacity-100">
                  {menu.children?.map((child) => (
                    <li class="nav-dropdown-item">
                      <a
                        href={child.url}
                        aria-label={child.name}
                        class={`nav-dropdown-link block ${
                          (pathname === `${child.url}/` ||
                            pathname === child.url) &&
                          "active"
                        }`}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={menu.url}
                  class={`nav-link block ${
                    (pathname === `${menu.url}/` || pathname === menu.url) &&
                    "active"
                  }`}
                >
                  {menu.name}
                </a>
              </li>
            )}
          </>
        ))
      }
    </ul>

    <!-- 우측 유틸리티 (검색, 테마, 버튼, 모바일 햄버거) -->
    <div class="order-1 ml-auto flex items-center lg:order-2 lg:ml-0">
      {
        settings.search && (
          <button
            class="border-border text-text-dark hover:text-primary dark:border-darkmode-border mr-4 inline-block border-r pr-4 text-xl dark:text-white dark:hover:text-darkmode-primary lg:mr-5 lg:pr-5"
            aria-label="search"
            data-search-trigger
          >
            <IoSearch />
          </button>
        )
      }
      <ThemeSwitcher className="mr-4 lg:mr-5" />
      {
        navigation_button.enable && (
          <a
            class="btn btn-outline-primary btn-sm hidden lg:inline-block"
            href={navigation_button.link}
            target={
              navigation_button.link.startsWith("http") ? "_blank" : "_self"
            }
            rel={navigation_button.link.startsWith("http") ? "noopener" : ""}
          >
            {navigation_button.label}
          </a>
        )
      }

      <!-- 모바일 메뉴 열기 버튼 (햄버거) -->
      <button
        id="mobile-menu-open"
        type="button"
        aria-label="Menu Open"
        class="cursor-pointer flex items-center lg:hidden text-text-dark dark:text-white p-1"
      >
        <svg class="h-6 w-6 fill-current" viewBox="0 0 20 20">
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0V15z"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- 모바일 전용 우측 사이드 드로어 메뉴 -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 z-50 hidden justify-end lg:hidden"
  >
    <!-- 좌측 반투명 어두운 배경 (클릭 시 메뉴 닫힘) -->
    <div
      id="mobile-menu-backdrop"
      class="fixed inset-0 bg-black/50 backdrop-blur-xs transition-opacity"
    ></div>

    <!-- 우측 드로어 패널 (화면의 반 정도 너비) -->
    <div
      class="relative z-10 flex h-full w-4/5 max-w-sm flex-col bg-body dark:bg-darkmode-body shadow-2xl border-l border-border dark:border-darkmode-border"
    >
      <!-- 드로어 상단 헤더 (로고 + 닫기 X 버튼 고정) -->
      <div
        class="flex items-center justify-between px-6 py-10 shrink-0"
      >
        <Logo />
        <button
          id="mobile-menu-close"
          type="button"
          aria-label="Menu Close"
          class="cursor-pointer p-2 -mr-2 text-text-dark dark:text-white hover:opacity-75"
        >
          <svg
            class="h-6 w-6 stroke-current"
            fill="none"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- 모바일 메뉴 리스트 (스크롤 영역) -->
      <div class="flex-1 overflow-y-auto px-6 py-6">
        <ul class="flex flex-col space-y-0">
          {
            main.map((menu) => (
              <li class="pb-2">
                {menu.hasChildren ? (
                  <details class="group">
                    <summary
                      class={`flex cursor-pointer list-none items-center justify-between py-3 text-base font-medium text-text-dark dark:text-white ${
                        menu.children?.map(({ url }) => url).includes(pathname) ||
                        menu.children
                          ?.map(({ url }) => `${url}/`)
                          .includes(pathname)
                          ? "text-primary dark:text-darkmode-primary"
                          : ""
                      }`}
                    >
                      <span>{menu.name}</span>
                      <svg
                        class="h-5 w-5 fill-current transition-transform duration-200 group-open:rotate-180"
                        viewBox="0 0 20 20"
                      >
                        <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                      </svg>
                    </summary>
                    <ul class="mt-1 mb-2 flex flex-col space-y-0 pl-4 border-l-1 border-primary dark:border-darkmode-primary">
                      {menu.children?.map((child) => (
                        <li>
                          <a
                            href={child.url}
                            class={`block py-2 text-sm text-text dark:text-darkmode-text hover:text-primary dark:hover:text-darkmode-primary ${
                              (pathname === `${child.url}/` ||
                                pathname === child.url) &&
                              "font-semibold text-primary dark:text-darkmode-primary"
                            }`}
                          >
                            {child.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <a
                    href={menu.url}
                    class={`block py-3 text-base font-medium text-text-dark dark:text-white hover:text-primary dark:hover:text-darkmode-primary ${
                      (pathname === `${menu.url}/` || pathname === menu.url) &&
                      "text-primary dark:text-darkmode-primary"
                    }`}
                  >
                    {menu.name}
                  </a>
                )}
              </li>
            ))
          }
        </ul>

        {
          navigation_button.enable && (
            <div class="mt-8">
              <a
                class="btn btn-outline-primary w-full text-center block"
                href={navigation_button.link}
                target={
                  navigation_button.link.startsWith("http") ? "_blank" : "_self"
                }
                rel={navigation_button.link.startsWith("http") ? "noopener" : ""}
              >
                {navigation_button.label}
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const openBtn = document.getElementById("mobile-menu-open");
    const closeBtn = document.getElementById("mobile-menu-close");
    const backdrop = document.getElementById("mobile-menu-backdrop");
    const overlay = document.getElementById("mobile-menu-overlay");

    if (!openBtn || !closeBtn || !overlay) return;

    const openMenu = () => {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      document.body.style.overflow = "";
    };

    openBtn.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);
    backdrop?.addEventListener("click", closeMenu);
  }

  function initDesktopDropdowns() {
    const dropdownItems = Array.from(document.querySelectorAll(".nav-dropdown"));
    if (dropdownItems.length === 0) return;

    const closeAll = (exceptItem?: Element | null) => {
      dropdownItems.forEach((item) => {
        if (item === exceptItem) return;
        item.classList.remove("is-open");
        item.querySelector(".nav-dropdown-toggle")?.setAttribute("aria-expanded", "false");
      });
    };

    dropdownItems.forEach((item) => {
      if ((item as HTMLElement).dataset.dropdownBound === "true") return;
      (item as HTMLElement).dataset.dropdownBound = "true";

      const toggleBtn = item.querySelector(".nav-dropdown-toggle");
      toggleBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const willOpen = !item.classList.contains("is-open");
        closeAll(item);
        item.classList.toggle("is-open", willOpen);
        toggleBtn.setAttribute("aria-expanded", String(willOpen));
      });
    });

    if (document.body.dataset.dropdownGlobalBound !== "true") {
      document.body.dataset.dropdownGlobalBound = "true";

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target?.closest(".nav-dropdown")) {
          closeAll();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeAll();
        }
      });
    }
  }

  function initHeader() {
    initMobileMenu();
    initDesktopDropdowns();
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>
