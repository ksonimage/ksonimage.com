---
const { section, currentPage, totalPages } = Astro.props;

// 💡 section이 "en"이면 "/en", 안 들어오면 "/", 그 외 섹션은 "/section"
let indexPageLink = "/";
if (section) {
  indexPageLink = section.startsWith("/") ? section : `/${section}`;
  // 끝에 슬래시(/)가 있다면 제거 (trailingSlash: 'never' 대응)
  if (indexPageLink.endsWith("/") && indexPageLink !== "/") {
    indexPageLink = indexPageLink.slice(0, -1);
  }
}

const pageList: (number | string)[] = [];

if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) {
    pageList.push(i);
  }
} else {
  pageList.push(1);
  if (currentPage > 3) pageList.push("...");

  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);

  for (let i = start; i <= end; i++) {
    pageList.push(i);
  }

  if (currentPage < totalPages - 2) pageList.push("...");
  pageList.push(totalPages);
}

const hasPrevPage = currentPage > 1;
const hasNextPage = currentPage < totalPages;

// 💡 슬래시 중복 방지 링크 생성 함수
const getPageLink = (page: number) => {
  if (page === 1) return indexPageLink;
  return indexPageLink === "/" ? `/page/${page}` : `${indexPageLink}/page/${page}`;
};
---

{
  totalPages > 1 && (
    <nav class="mb-4 flex justify-center space-x-2" aria-label="Pagination">
      {/* 이전 페이지 버튼 */}
      {hasPrevPage ? (
        <a
          href={getPageLink(currentPage - 1)}
          class="inline-flex h-10 items-center justify-center rounded px-4 font-semibold text-dark hover:bg-theme-light dark:text-darkmode-dark dark:hover:bg-darkmode-theme-light"
        >
          {section === "en" || section?.startsWith("en") ? "Prev" : "이전"}
        </a>
      ) : (
        <span class="inline-flex h-10 items-center justify-center rounded px-4 font-semibold text-text-light opacity-50 dark:text-darkmode-text-light cursor-not-allowed">
          {section === "en" || section?.startsWith("en") ? "Prev" : "이전"}
        </span>
      )}

      {/* 페이지 번호 목록 */}
      {pageList.map((pagination) =>
        pagination === "..." ? (
          <span class="inline-flex h-10 w-10 items-center justify-center font-semibold text-text-light dark:text-darkmode-text-light">
            ...
          </span>
        ) : pagination === currentPage ? (
          <span
            aria-current="page"
            class="inline-flex h-10 w-10 items-center justify-center rounded bg-primary font-semibold text-white"
          >
            {pagination}
          </span>
        ) : (
          <a
            href={getPageLink(Number(pagination))}
            class="inline-flex h-10 w-10 items-center justify-center rounded font-semibold text-dark hover:bg-theme-light dark:text-darkmode-dark dark:hover:bg-darkmode-theme-light"
          >
            {pagination}
          </a>
        )
      )}

      {/* 다음 페이지 버튼 */}
      {hasNextPage ? (
        <a
          href={getPageLink(currentPage + 1)}
          class="inline-flex h-10 items-center justify-center rounded px-4 font-semibold text-dark hover:bg-theme-light dark:text-darkmode-dark dark:hover:bg-darkmode-theme-light"
        >
          {section === "en" || section?.startsWith("en") ? "Next" : "다음"}
        </a>
      ) : (
        <span class="inline-flex h-10 items-center justify-center rounded px-4 font-semibold text-text-light opacity-50 dark:text-darkmode-text-light cursor-not-allowed">
          {section === "en" || section?.startsWith("en") ? "Next" : "다음"}
        </span>
      )}
    </nav>
  )
}
