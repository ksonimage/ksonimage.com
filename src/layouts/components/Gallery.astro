---
// Gallery.astro
interface Props {
  images: string[];
}

const { images = [] } = Astro.props;
---

<div class="custom-gallery grid grid-cols-3 sm:grid-cols-8 gap-1 my-0">
  {images.map((imgUrl, index) => (
    <button
      type="button"
      data-img-src={imgUrl}
      data-index={index}
      class="gallery-thumb-btn group overflow-hidden rounded bg-gray-100 aspect-square block cursor-pointer border border-gray-200 shadow-sm focus:outline-none"
    >
      <img
        src={imgUrl}
        alt={`Gallery Image ${index + 1}`}
        class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105 pointer-events-none"
        loading="lazy"
      />
    </button>
  ))}
</div>

<dialog id="floating-modal" class="fixed inset-0 z-50 p-0 m-auto bg-transparent backdrop:bg-black/50 backdrop:backdrop-blur-md border-0 focus:outline-none max-w-[95vw] max-h-[95vh] open:flex items-center justify-center">
  <div id="modal-backdrop-close" class="relative flex items-center justify-between w-full h-full p-4 sm:p-8 cursor-pointer select-none">

    {/* 우측 상단 닫기(X) 버튼 */}
    <button
      id="modal-close-btn"
      type="button"
      aria-label="Close lightbox"
      title="Close [ESC]"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-20 p-2.5 text-white/80 hover:text-white bg-black/35 hover:bg-black/65 backdrop-blur-sm rounded-full transition-all duration-200 cursor-pointer focus:outline-none select-none"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button
      id="modal-prev-btn"
      type="button"
      aria-label="Previous image"
      class="shrink-0 z-10 p-3 text-white/70 hover:text-white bg-black/30 hover:bg-black/60 backdrop-blur-sm rounded-full transition-all duration-200 cursor-pointer focus:outline-none select-none"
    >
      <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <div class="flex items-center justify-center flex-1 h-full mx-2 sm:mx-6 pointer-events-none">
      <img
        id="modal-img"
        src=""
        alt="Expanded Image"
        class="max-w-[75vw] max-h-[80vh] w-auto h-auto object-contain rounded-lg shadow-2xl transition-all duration-150 pointer-events-auto cursor-default"
      />
    </div>

    <button
      id="modal-next-btn"
      type="button"
      aria-label="Next image"
      class="shrink-0 z-10 p-3 text-white/70 hover:text-white bg-black/30 hover:bg-black/60 backdrop-blur-sm rounded-full transition-all duration-200 cursor-pointer focus:outline-none select-none"
    >
      <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

  </div>
</dialog>

<script>
  const initGallery = () => {
    const dialog = document.getElementById('floating-modal') as HTMLDialogElement | null;
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('modal-close-btn');
    const prevBtn = document.getElementById('modal-prev-btn');
    const nextBtn = document.getElementById('modal-next-btn');
    const backdropClose = document.getElementById('modal-backdrop-close');
    const buttons = Array.from(document.querySelectorAll('.gallery-thumb-btn'));

    if (!dialog || !modalImg || buttons.length === 0) return;
    if (dialog.dataset.bound === 'true') return;
    dialog.dataset.bound = 'true';

    let currentIndex = 0;

    const updateImage = (index: number) => {
      currentIndex = (index + buttons.length) % buttons.length;
      const targetBtn = buttons[currentIndex];
      const src = targetBtn ? targetBtn.getAttribute('data-img-src') : null;
      if (src && modalImg) {
        modalImg.src = src;
      }
    };

    buttons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        updateImage(idx);
        if (dialog.showModal) {
          dialog.showModal();
        }
      });
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      dialog.close();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateImage(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateImage(currentIndex + 1);
    });

    backdropClose?.addEventListener('click', (e) => {
      if (e.target === backdropClose) {
        dialog.close();
      }
    });

    const handleKeyDown = (e: KeyboardEvent) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') {
        updateImage(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        updateImage(currentIndex + 1);
      }
    };

    window.addEventListener('keydown', handleKeyDown);

    dialog.addEventListener('close', () => {
      if (modalImg) modalImg.src = '';
    });
  };

  document.addEventListener('astro:page-load', initGallery);
  if (document.readyState === 'complete') {
    initGallery();
  } else {
    document.addEventListener('DOMContentLoaded', initGallery);
  }
</script>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
  }

  dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
